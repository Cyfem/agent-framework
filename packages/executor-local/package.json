{
  "name": "@ruixutong.manee/maneeagent-executor-local",
  "version": "2.0.0",
  "description": "Official in-process Executor and local StateStore adapters for Manee Agent Framework.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:process": "vitest run --config vitest.process.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "peerDependencies": {
    "@ruixutong.manee/maneeagent-framework": "^2.0.0"
  },
  "devDependencies": {
    "@ruixutong.manee/maneeagent-framework": "workspace:^",
    "zod": "^4.4.3"
  }
}
