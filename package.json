{
  "name": "agent-framework-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter ./packages/core test && pnpm --filter ./packages/executor-local test && pnpm test:subagent:v2:process",
    "test:subagent:v2": "pnpm --filter ./packages/core test && pnpm --filter ./packages/executor-local test",
    "test:subagent:v2:process": "pnpm --filter ./packages/executor-local test:process",
    "typecheck": "pnpm -r run typecheck && tsc -p testkit/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:subagent:v2:manifest": "node test/acceptance/validate-manifest.mjs",
    "validate:subagent:v2:evidence": "node test/acceptance/validate-evidence.mjs",
    "validate:subagent:v2:legacy": "node test/acceptance/validate-legacy-source.mjs --forbid-all",
    "validate:subagent:v2:pack": "pnpm validate:subagent:v2:pack:core && pnpm validate:subagent:v2:pack:local",
    "validate:subagent:v2:pack:core": "node test/acceptance/validate-pack.mjs --expected-version=2.0.0 packages/core",
    "validate:subagent:v2:pack:local": "node test/acceptance/validate-pack.mjs --expected-version=2.0.0 packages/executor-local",
    "toolchain:node22": "powershell -NoProfile -ExecutionPolicy Bypass -File tooling/node/bootstrap-node22.ps1",
    "demo": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo dev",
    "demo:chat": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo chat",
    "demo:complex": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo complex",
    "demo:ark": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo ark:full",
    "demo:ark:smoke": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo ark:smoke",
    "demo:ark:coding": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo ark:coding",
    "demo:ark:subagent": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo ark:subagent",
    "demo:features:ark": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo features:ark",
    "demo:windows": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo windows",
    "demo:windows:chat": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo windows:chat",
    "demo:electron:weixin": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo electron:weixin",
    "demo:finance-news": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo finance-news",
    "demo:finance-news:smoke": "pnpm --filter \"@manee/agent-framework-demo...\" --filter \"!@manee/agent-framework-demo\" build && pnpm --filter @manee/agent-framework-demo finance-news:smoke"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.13",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
